# GEMINI_API_KEY: Required for Gemini AI API calls (VERTYLEX Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only authentication session cookies.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# ADMIN_EMAILS & ADMIN_OWNER_PASSWORD: Pre-authorized VERTYLEX owner email(s) and bootstrap password (minimum 8 chars).
# Public website registration always creates customer accounts and strictly rejects reserved admin emails.
ADMIN_EMAILS="vertylexvtylex@gmail.com"
ADMIN_OWNER_PASSWORD=""

# Optional SMTP configuration for outbound email delivery of project enquiries, escalations, and password resets.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VERTYLEX <vertylexvtylex@gmail.com>"

# Optional Official WhatsApp Business Platform Cloud API configuration.
# WhatsApp Business integration remains inactive until these official credentials are configured.
WHATSAPP_BUSINESS_PHONE_ID=""
WHATSAPP_BUSINESS_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_VERIFY_TOKEN=""
WHATSAPP_BUSINESS_OFFICIAL_URL=""

# Optional Payment Gateway Secret Keys (Paystack / Flutterwave).
# Live website checkout remains inactive until a legitimate merchant secret key is configured.
PAYSTACK_SECRET_KEY=""
FLW_SECRET_KEY=""
FLW_WEBHOOK_HASH=""
